# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# OTA update server: private signing key and published updates stay on this machine
/update-server/keys/
/update-server/updates/
# Public code-signing certificate for updates (the private key stays ignored)
!/certs/certificate.pem

# Status server: access token stays on this machine
/status-server/token
/status-server/pairing
/status-server/history.json
/status-server/history.json.tmp
/status-server/history.json.old
/status-server/history-*.jsonl*
/status-server/events.jsonl*
/status-server/power.json
/status-server/game-mode.json
/status-server/videos.json
/status-server/conversions.json
/status-server/cleanup.json
/status-server/requests.json
